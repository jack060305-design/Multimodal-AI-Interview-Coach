# Azure Container Apps — env vars (portal, deploy.ps1, or GitHub Actions secrets)

DEPLOY_PROFILE=cloud
WHISPER_BACKEND=openai
VECTOR_STORE=memory
DB_ENABLED=false

# LLM scoring + daily LangGraph agents (pick one provider)
# anthropic (recommended) | gemini | openai
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-haiku-20241022
# gemini:  LLM_PROVIDER=gemini  LLM_MODEL=gemini-2.0-flash
# openai:  LLM_PROVIDER=openai   LLM_MODEL=gpt-4o-mini

# API keys — set the key matching LLM_PROVIDER
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Whisper (cloud video upload) — OpenAI only today; keep even if LLM is Anthropic/Gemini
# OPENAI_API_KEY=sk-...

CORS_ORIGINS=https://multimodal-ai-interview-coach.vercel.app,http://localhost:3000

# Daily question pipeline — LangGraph multi-agent
DAILY_QUESTIONS_ENABLED=true
DAILY_QUESTIONS_MODE=agentic
DAILY_QUESTIONS_CRON=0 6 * * *
DAILY_QUESTIONS_PER_ROLE=3
DAILY_QUESTIONS_MAX_REVISIONS=1

# LangSmith tracing (optional — debug agent runs)
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach-daily-agents
