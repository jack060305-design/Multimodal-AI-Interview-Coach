# Azure Container Apps — copy to secrets / env in portal or use deploy.ps1

DEPLOY_PROFILE=cloud
WHISPER_BACKEND=openai
VECTOR_STORE=memory
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
DB_ENABLED=false

# Required
OPENAI_API_KEY=
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# Daily question pipeline — LangGraph multi-agent (Phương án 3)
DAILY_QUESTIONS_ENABLED=true
DAILY_QUESTIONS_MODE=agentic
DAILY_QUESTIONS_CRON=0 6 * * *
DAILY_QUESTIONS_PER_ROLE=3
DAILY_QUESTIONS_MAX_REVISIONS=1

# LangSmith tracing (optional, recommended for agent debugging)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach-daily-agents
