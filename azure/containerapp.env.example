# Azure Container Apps — env vars (portal, deploy.ps1, or GitHub Actions secrets)

DEPLOY_PROFILE=cloud
WHISPER_BACKEND=openai
VECTOR_STORE=chroma
EMBEDDING_BACKEND=openai
CHROMA_PERSIST_DIR=/tmp/chroma

# Postgres + Auth (Azure Database for PostgreSQL flexible server)
DB_ENABLED=true
DATABASE_URL=postgresql+psycopg2://user:pass@your-server.postgres.database.azure.com:5432/interview_coach?sslmode=require
JWT_SECRET=
FRONTEND_URL=https://multimodal-ai-interview-coach.vercel.app
PUBLIC_API_URL=https://your-api.azurecontainerapps.io
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# S3-compatible storage (AWS S3 or Azure Blob with S3 API)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=interview-coach-videos

# LLM scoring + daily LangGraph agents (pick one provider)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

CORS_ORIGINS=https://multimodal-ai-interview-coach.vercel.app,http://localhost:3000

DAILY_QUESTIONS_ENABLED=true
DAILY_QUESTIONS_MODE=agentic
DAILY_QUESTIONS_CRON=0 6 * * *
DAILY_QUESTIONS_PER_ROLE=3
DAILY_QUESTIONS_MAX_REVISIONS=1

LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach-daily-agents
