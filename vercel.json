{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/out",
  "rewrites": [
    {
      "source": "/roles",
      "destination": "https://interview-coach-api.onrender.com/roles"
    },
    {
      "source": "/questions/:path*",
      "destination": "https://interview-coach-api.onrender.com/questions/:path*"
    },
    {
      "source": "/evaluate",
      "destination": "https://interview-coach-api.onrender.com/evaluate"
    },
    {
      "source": "/gpu/:path*",
      "destination": "https://interview-coach-api.onrender.com/gpu/:path*"
    },
    {
      "source": "/evaluations",
      "destination": "https://interview-coach-api.onrender.com/evaluations"
    },
    {
      "source": "/health",
      "destination": "https://interview-coach-api.onrender.com/health"
    }
  ]
}
