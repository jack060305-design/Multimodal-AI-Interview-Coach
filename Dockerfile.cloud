FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements-cloud.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY rubrics/ ./rubrics/

WORKDIR /app/backend

# Student-budget defaults: Azure Files mount at /app/backend/data (no paid S3 required)
ENV DEPLOY_PROFILE=cloud
ENV WHISPER_BACKEND=openai
ENV VECTOR_STORE=chroma
ENV EMBEDDING_BACKEND=openai
ENV LLM_PROVIDER=openai
ENV DB_ENABLED=false
ENV STORAGE_BACKEND=local
ENV DATA_DIR=/app/backend/data
ENV CHROMA_PERSIST_DIR=/app/backend/data/chroma
ENV LOCAL_STORAGE_DIR=/app/backend/data/uploads
ENV WORK_DIR=/tmp/interview-work
ENV SKIP_VIDEO_STORAGE=false

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=15s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
