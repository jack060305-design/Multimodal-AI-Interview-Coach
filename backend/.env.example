# =============================================================================
# Interview Coach - backend settings
# Copy to .env (setup.cmd does this automatically)
# =============================================================================
#
# NEW USER DEFAULTS (works without OpenAI):
#   LLM_PROVIDER=local
#   DB_ENABLED=false
#
# For GPT scoring instead of local scoring:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=sk-your-key-here
#
# =============================================================================

LLM_PROVIDER=local
LLM_MODEL=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
ACCELERATOR_MODE=auto
GPU_VENDOR=auto
GPU_CONSENT=prompt

VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
WORK_DIR=./data/work

DB_ENABLED=false
DATABASE_URL=postgresql+psycopg2://interview:interview@localhost:5432/interview_coach

# Auth (requires DB_ENABLED=true)
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_HOURS=168
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

CORS_ORIGINS=http://localhost:3000,https://interview-coach-nine-sigma.vercel.app,https://multimodal-ai-interview-coach.vercel.app

# --- Cloud deploy (Azure / Render / Railway + Vercel frontend) ---
# DEPLOY_PROFILE=cloud
# WHISPER_BACKEND=openai
# --- Cloud: OpenAI embeddings + Chroma RAG ---
# EMBEDDING_BACKEND=openai
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_STORE=chroma
# CHROMA_PERSIST_DIR=/tmp/chroma
#
# LLM (pick one provider):
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-20241022
# ANTHROPIC_API_KEY=sk-ant-...
#
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash
# GOOGLE_API_KEY=...
#
# Whisper on cloud still uses OpenAI API (even if LLM is Anthropic/Gemini):
# OPENAI_API_KEY=sk-...
#
# LangSmith tracing (optional):
# LANGCHAIN_TRACING_V2=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=interview-coach-daily-agents
#
# On Vercel: NEXT_PUBLIC_API_URL=https://your-api.azurecontainerapps.io

# --- Optional: OpenAI / Anthropic / Gemini ---
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# Student budget: Neon Postgres free tier — paste connection string when DB_ENABLED=true
# SKIP_VIDEO_STORAGE=true saves Render disk; scores still persist in Postgres
SKIP_VIDEO_STORAGE=false

# --- Optional: NVIDIA GPU ---
# pip install -r requirements-gpu.txt
# ACCELERATOR_MODE=gpu

# --- Optional: AMD GPU (e.g. RX 6700 XT) ---
# pip install -r requirements-amd.txt
# GPU_VENDOR=amd
# WHISPER_BACKEND=onnx_directml

# --- Optional: Pinecone / S3 / LangSmith ---
PINECONE_API_KEY=
PINECONE_INDEX=interview-rubrics
PINECONE_NAMESPACE=rubrics
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=interview-coach-videos
S3_ENDPOINT_URL=
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach
