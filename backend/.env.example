# =============================================================================
# Interview Coach - backend settings (copy to .env — setup.cmd does this)
# =============================================================================
# Local default: SQLite at ./data/app.db (login + history, no Postgres password).
# Shared Supabase Postgres: set SUPABASE_DB_PASSWORD below.
# =============================================================================

LLM_PROVIDER=local
LLM_MODEL=local
DEPLOY_PROFILE=local
EMBEDDING_BACKEND=huggingface

DB_ENABLED=true
DATA_DIR=./data

# Supabase Auth (same project as frontend .env.local)
SUPABASE_URL=https://ttgdcomdfqmbqqiywoxw.supabase.co
SUPABASE_ANON_KEY=sb_publishable_oAWTc_IxskWk11vaU7JzOg_74RccE7t
# Firebase Google login (same project ID as frontend NEXT_PUBLIC_FIREBASE_PROJECT_ID)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional — use cloud Postgres instead of local SQLite:
# SUPABASE_DB_PASSWORD=your-database-password
# SUPABASE_JWT_SECRET=from-supabase-dashboard-api-settings

JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRE_HOURS=168
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Facebook Login (Backend OAuth — Meta Graph API /me)
# Redirect URI: http://localhost:8000/auth/facebook/callback (local)
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# FACEBOOK_REDIRECT_URI=http://localhost:8000/auth/facebook/callback

VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
WORK_DIR=./data/work
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

WHISPER_MODEL=base
ACCELERATOR_MODE=auto
CORS_ORIGINS=http://localhost:3000,https://multimodal-ai-interview-coach.vercel.app

OPENAI_API_KEY=
SKIP_VIDEO_STORAGE=false
LANGCHAIN_TRACING_V2=false

# --- Cloud deploy (Azure / Vercel) ---
# DEPLOY_PROFILE=cloud
# WHISPER_BACKEND=openai
# EMBEDDING_BACKEND=openai
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# On Vercel: NEXT_PUBLIC_API_URL=https://your-api.azurecontainerapps.io
# On Azure: set DATABASE_URL via GitHub Secret (see scripts/setup-azure-supabase-db.ps1)
