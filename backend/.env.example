# LLM (openai | anthropic | gemini)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# GPU vendor: auto | nvidia | amd | cpu
# GPU consent: prompt (ask user) | always | never
#   prompt = must ask once/always/never in UI before GPU (default, safest)
# ---------------------------------------------------------------------------
GPU_VENDOR=auto
GPU_CONSENT=prompt
ACCELERATOR_MODE=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE=auto
WHISPER_BACKEND=auto
EMBEDDING_DEVICE=auto
WHISPER_MODEL=base

# --- AMD Radeon (e.g. RX 6700 XT on Windows) ---
# GPU_VENDOR=amd
# AMD_GPU_NAME=RX 6700 XT
# WHISPER_BACKEND=onnx_directml
# pip install -r requirements-amd.txt

# --- NVIDIA CUDA ---
# GPU_VENDOR=nvidia
# ACCELERATOR_MODE=gpu
# WHISPER_MODEL=large-v3
# pip install -r requirements-gpu.txt

# Vector store (chroma | pinecone)
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma
PINECONE_API_KEY=
PINECONE_INDEX=interview-rubrics
PINECONE_NAMESPACE=rubrics

# Postgres
DB_ENABLED=true
DATABASE_URL=postgresql+psycopg2://interview:interview@localhost:5432/interview_coach

# Object storage (local | s3)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=interview-coach-videos
S3_ENDPOINT_URL=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interview-coach

WORK_DIR=./data/work
CORS_ORIGINS=http://localhost:3000
