# Supabase Auth — project ttgdcomdfqmbqqiywoxw
# Copy to .env.local for local dev (gitignored)

NEXT_PUBLIC_SUPABASE_URL=https://ttgdcomdfqmbqqiywoxw.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_oAWTc_IxskWk11vaU7JzOg_74RccE7t

# OAuth: set true ONLY after enabling provider in Supabase Dashboard
NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_OAUTH_FACEBOOK_ENABLED=false

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Branded Google sign-in (shows your app domain on account picker — not *.supabase.co)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=351991371513-9d05bk071kcplt52tpe10hpjlrtorf3v.apps.googleusercontent.com

# Facebook Login via Backend OAuth (Meta Graph API — see scripts/setup-facebook-backend-oauth.ps1)
NEXT_PUBLIC_BACKEND_FACEBOOK_OAUTH=true

# Firebase + Supabase dual auth (recommended for Google — Firebase login, Supabase DB/email)
# Run: ..\scripts\setup-firebase-supabase.ps1
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# NEXT_PUBLIC_FIREBASE_APP_ID=
# Set true ONLY after Firebase Console → Authentication → Get started → Google → Enable
# NEXT_PUBLIC_FIREBASE_AUTH_ENABLED=false

# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: http://localhost:3000 (dev) or https://multimodal-ai-interview-coach.vercel.app (prod)
#   Redirect URLs:
#     http://localhost:3000/auth/callback
#     https://multimodal-ai-interview-coach.vercel.app/auth/callback
#
# Email signup (recommended first):
#   Authentication → Providers → Email → ON
#   Optional dev: disable "Confirm email" for instant login
#
# Google OAuth — branded picker (recommended) OR legacy Supabase redirect
# Branded: set NEXT_PUBLIC_GOOGLE_CLIENT_ID (Web client) — see scripts/setup-supabase-google.ps1
# Legacy redirect shows *.supabase.co on Google's screen
#   1. Supabase → Authentication → Providers → Google → Enable + Client ID/Secret
#   2. Google Cloud → OAuth redirect: https://ttgdcomdfqmbqqiywoxw.supabase.co/auth/v1/callback
#   3. Set NEXT_PUBLIC_OAUTH_GOOGLE_ENABLED=true on Vercel / .env.local
#
# Facebook Login — Backend OAuth (Meta Graph API, not Supabase redirect)
#   1. Meta Developers → Create App → Facebook Login
#   2. Valid OAuth Redirect URI: http://localhost:8000/auth/facebook/callback
#      (prod: https://your-api.azurecontainerapps.io/auth/facebook/callback)
#   3. backend/.env: FACEBOOK_APP_ID + FACEBOOK_APP_SECRET
#   4. NEXT_PUBLIC_BACKEND_FACEBOOK_OAUTH=true (below)
#   Run: ..\scripts\setup-facebook-backend-oauth.ps1
